{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".output/public",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/server.mjs": {
      "includeFiles": ".output/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server.mjs"
    }
  ]
}
